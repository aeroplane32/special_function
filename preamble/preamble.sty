    basicstyle=\small\ttconsolas,                           % basic fontsize in it
    breaklines=true
}

\newcommand{\trm}[1]{{\rm #1}}

\newenvironment{definition}[1]
    {\begin{tcolorbox}[enhanced, colback=LightYellow, breakable=true, frame hidden, borderline west={1.5mm}{-2mm}{DarkGreen}, segmentation style = {draw = DarkGreen, solid}, boxsep = 0pt]
    {\bfseries {\color{DarkGreen} 定义}\quad #1} \tcblower}
    {\end{tcolorbox}}

\newenvironment{theorem}[1]
    {\begin{tcolorbox}[enhanced, colback=LightYellow, breakable=true, frame hidden, borderline west={1.5mm}{-2mm}{DarkBlue}, segmentation style = {draw = DarkBlue, solid}, boxsep = 0pt]
    {\bfseries {\color{DarkBlue} 定理}\quad \ifx!#1! \relax \else #1 \fi} \ifx!#1! \relax\else \tcblower \fi}
    {\end{tcolorbox}}

\newenvironment{proposition}[1]
    {\begin{tcolorbox}[enhanced, colback=LightYellow, breakable=true, frame hidden, borderline west={1.5mm}{-2mm}{Purple}, segmentation style = {draw = Purple, solid}, boxsep = 0pt]
    {\bfseries {\color{Purple} 命题}\quad \ifx!#1! \relax \else #1 \fi} \ifx!#1! \relax\else \tcblower \fi}
    {\end{tcolorbox}}

\newenvironment{corollary}[1]
    {\begin{tcolorbox}[enhanced, colback=LightYellow, breakable=true, frame hidden, borderline west={1.5mm}{-2mm}{Brown}, boxsep = 0pt]
    {\bfseries {\color{Brown} 推论}\quad \ifx!#1! \relax \else #1 \fi} \ifx!#1! \relax\else \tcblower \fi}
    {\end{tcolorbox}}

\newenvironment{lemma}[1]
    {\begin{tcolorbox}[enhanced, colback=LightYellow, breakable=true, frame hidden, borderline west={1.5mm}{-2mm}{DarkRed}, segmentation style = {draw = DarkRed, solid}, boxsep = 0pt]
    {\bfseries {\color{DarkRed} 引理}\quad \ifx!#1! \relax \else #1 \fi} \ifx!#1! \relax\else \tcblower \fi}
    {\end{tcolorbox}}

\newenvironment{reference}
    {\begin{tcolorbox}[enhanced, colback=GhostWhite, breakable=true, frame hidden, borderline west={1.5mm}{-2mm}{Gray}]}
    {\end{tcolorbox}}

\newenvironment{proof}{\paragraph{证明}\kaishu}{\hfill$\square$}
\newenvironment{note}{\kaishu\selectfont\small\par}{\hfill}
